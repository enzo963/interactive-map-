{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Heritage site records",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "governorate",
      "category",
      "period",
      "description",
      "images",
      "unesco",
      "has3D",
      "sources"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "governorate": {
        "type": "string"
      },
      "category": {
        "type": "string"
      },
      "period": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "images": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/image"
        }
      },
      "unesco": {
        "type": "boolean"
      },
      "has3D": {
        "type": "boolean"
      },
      "sources": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "additionalProperties": true
  },
  "definitions": {
    "source": {
      "type": "object",
      "required": [
        "sourceName",
        "url",
        "evidenceId",
        "accessedAt"
      ],
      "properties": {
        "sourceName": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "description": "An absolute HTTP(S) reference URL, or an empty string for a citation without a link.",
          "pattern": "^(https?://[^\\s]+|)$"
        },
        "evidenceId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "A real evidence record ID; null when not recorded."
        },
        "accessedAt": {
          "description": "A recorded ISO date or timezone-qualified timestamp; null when unknown. Do not fill with the current date.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "required": [
        "src",
        "alt",
        "caption",
        "credit",
        "license"
      ],
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "credit": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
