{
  "name": "history-in-cards",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-seo.mjs",
    "build:seo": "node scripts/build-seo.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate:production": "npm run build && node scripts/validate-production.mjs",
    "validate:history": "npm run build && node scripts/validate-history.mjs",
    "validate:map-viewer": "npm run build && node scripts/validate-map-viewer.mjs",
    "validate:digital": "npm run build && node scripts/validate-digital-heritage.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:cards": "node scripts/check-cards.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^6.15.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "vite": "^8.3.4"
  }
}
